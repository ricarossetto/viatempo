{
  "name": "previs-o-do-tempo-da-rota",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "node e2e/autodebug.mjs",
    "test:routing": "node e2e/routing.test.mjs",
    "test:journey": "esbuild e2e/journey.test.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/journey.test.mjs --log-level=error && node node_modules/.cache/journey.test.mjs",
    "cf:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.144.0"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
